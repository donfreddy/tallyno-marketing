---
import Logo from "./Logo.astro";

const links = [
	{ href: "/#comment", label: "Comment ça marche" },
	{ href: "/#regles", label: "Les règles" },
	{ href: "/#depenses", label: "Dépenses" },
	{ href: "/#tarifs", label: "Tarifs" },
	{ href: "/#faq", label: "FAQ" },
];
---

<header class="header">
	<div class="frame header__bar">
		<a href="/" class="header__brand" aria-label="Tallyno, accueil">
			<Logo tone="light" />
		</a>

		<nav class="header__nav" aria-label="Navigation principale">
			<ul>
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<a class="header__cta" href="/telecharger/">Télécharger</a>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--color-petrol-900) 94%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid color-mix(in srgb, #fff 10%, transparent);
	}

	.header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.25rem;
	}

	.header__brand {
		text-decoration: none;
	}

	.header__nav {
		display: none;
	}

	.header__nav ul {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.header__nav a {
		display: inline-block;
		padding: 0.45rem 0.7rem;
		color: color-mix(in srgb, #fff 78%, transparent);
		font-size: 0.95rem;
		font-weight: 500;
		text-decoration: none;
		border-radius: 0.5rem;
	}

	.header__nav a:hover {
		color: #fff;
		background: color-mix(in srgb, #fff 8%, transparent);
	}

	.header__cta {
		padding: 0.55rem 1.1rem;
		background: #fff;
		color: var(--color-petrol-900);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		border-radius: 0.7rem;
	}

	.header__cta:hover {
		background: var(--color-petrol-50);
	}

	@media (min-width: 56rem) {
		.header__nav {
			display: block;
		}
	}
</style>

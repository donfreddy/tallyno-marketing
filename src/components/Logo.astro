---
/** The Tallyno T mark (assets/brand/tallyno-mark.svg in tallyno-mobile) with the wordmark. */
interface Props {
	size?: number;
	tone?: "brand" | "light";
}

const { size = 30, tone = "brand" } = Astro.props;
---

<span class:list={["logo", `logo--${tone}`]}>
	<svg class="logo__tile" width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true">
		<rect width="1024" height="1024" rx="230" />
		<path d="M261 197H535A28 28 0 0 1 563 225V826H470A45 45 0 0 1 425 781V306H288A27 27 0 0 1 261 279Z" />
		<path d="M599 197H735A27 27 0 0 1 762 224V306H599Z" />
	</svg>
	<span class="logo__word">Tallyno</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.3rem;
		letter-spacing: -0.02em;
	}

	.logo__tile rect {
		fill: var(--color-petrol-600);
	}

	.logo__tile path {
		fill: #fff;
	}

	.logo--light .logo__tile rect {
		fill: #fff;
	}

	.logo--light .logo__tile path {
		fill: var(--color-petrol-700);
	}

	.logo--light .logo__word {
		color: #fff;
	}
</style>
